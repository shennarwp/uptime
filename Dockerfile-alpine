# Stage 1: Build Frontend
FROM node:24.19.0-alpine AS frontend-builder
WORKDIR /app/web
COPY web/package.json web/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY web/ ./
RUN npm run build

# Stage 2: Build Backend
FROM golang:1.27.1-alpine AS backend-builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /app/uptime ./cmd/uptime/main.go

# Stage 3: Runtime Image using prebuilt Nginx Alpine
FROM nginx:alpine
WORKDIR /app

LABEL org.opencontainers.image.title="uptime" \
      org.opencontainers.image.description="Lightweight self-hosted uptime monitoring application (Go backend, React frontend). Live version can be seen on https://uptime.rwpiri.com" \
      org.opencontainers.image.url="https://github.com/shennarwp/uptime" \
      org.opencontainers.image.source="https://github.com/shennarwp/uptime" \
      org.opencontainers.image.documentation="https://github.com/shennarwp/uptime/blob/main/README.md" \
      org.opencontainers.image.authors="Shenna Risqianto Wilfred Piri <shenna@rwpiri.com>" \
      org.opencontainers.image.vendor="shennarwp"

RUN apk --no-cache add ca-certificates

# Copy custom Nginx configuration
COPY configs/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built frontend static files to Nginx web root
COPY --from=frontend-builder /app/web/dist /usr/share/nginx/html

# Copy Go backend binary
COPY --from=backend-builder /app/uptime /app/uptime

# Copy startup entrypoint script
COPY configs/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

ENV UPTIME_DB_PATH=/app/data/uptime.db

EXPOSE 80

CMD ["/app/entrypoint.sh"]
